{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adityajain-ca",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/projects/*", "!/og/*", "!/og.png", "!/favicon.svg", "!/Aditya_Jain_Resume.pdf"],
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [{ "binding": "DATES_KV" }],
  "keep_vars": true
}
