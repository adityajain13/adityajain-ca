// Cloudflare Workers config.
// worker/index.ts routes each subdomain; Vite's build output in dist/ is served as static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adityajain-ca",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The worker needs to see every request so it can route by hostname.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // Storage for the private date tracker (dates.adityajain.ca).
  // No id: Wrangler creates the namespace on the first deploy and reuses it after.
  "kv_namespaces": [{ "binding": "DATES_KV" }],
  // Settings for the date tracker are set in the dashboard as secrets; keep them on deploy.
  "keep_vars": true
}
